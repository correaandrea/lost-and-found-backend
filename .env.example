# Copia este archivo a .env y completa los valores. El archivo .env no se versiona.

# PostgreSQL (por ejemplo, la cadena de conexión de un proyecto en Neon)
DATABASE_URL=

# Cloudinary (almacenamiento de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth 2.0 (aplicación web). La URL de retorno debe estar registrada en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Secreto para firmar los JWT: usa un valor largo y aleatorio
JWT_SECRET=

# Correos con rol administrador, separados por coma (se aplica en el siguiente inicio de sesión)
ADMIN_EMAILS=
